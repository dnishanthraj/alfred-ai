# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — your keys never leave your machine.

# --- ElevenLabs (text-to-speech) ---
# Get an API key at https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID for the assistant's voice (from your ElevenLabs voice library)
ALFRED_VOICE_ID=your_elevenlabs_voice_id

# --- Your identity (shown in the console, and used as a Whisper hint) ---
ALFRED_USER_NAME=YourName

# Which Ollama model Alfred answers with. Every other per-character setting —
# display name, role, voice, sampling parameters, worked examples — lives in
# wayne/contacts/profiles/alfred.json, not here.
ALFRED_OLLAMA_MODEL=alfred

# --- Push-to-talk hotkey (pynput key name) ---
# Examples: Key.cmd_r, Key.shift_r, Key.ctrl_r
ALFRED_PTT_KEY=Key.cmd_r

# --- Whisper transcription hints ---
# Comma-separated proper nouns to bias speech-to-text recognition
ALFRED_WHISPER_HINTS=Alfred, YourName

# --- Web console ---
ALFRED_WEB_HOST=127.0.0.1
ALFRED_WEB_PORT=8420

# Lock-screen passcode. This is stagecraft, not security — it is checked in the
# page, the server gates nothing on it, and it sits in plain text right here.
# Don't put anything behind it that actually needs protecting.
WAYNE_PASSCODE=zorro

# Contact the console connects to on load.
WAYNE_DEFAULT_CONTACT=alfred

# --- Memory encryption ---
# Encrypts conversation history and the vault at rest. Generate one with
# `python run.py --new-key`. Real encryption, unlike the lock screen above —
# but the key lives here beside the data, so it guards against casual reading,
# backups and sync clients, not against someone who already has this file.
# Lose the key and the memory is unreadable.
# WAYNE_MEMORY_KEY=

# --- Web search (optional) ---
# Without a key, search uses DuckDuckGo: no account needed, but scraped and
# rate-limited, so it can return nothing under repeated use. Brave is a real
# API with a free tier and cleaner results — https://brave.com/search/api/
# BRAVE_API_KEY=

# --- Latency ---
# How long Ollama keeps the model resident. The default 5m means a chat resumed
# after a coffee pays a full ~25s model load before the first word.
ALFRED_MODEL_KEEP_ALIVE=1h

# --- ElevenLabs model (optional) ---
ALFRED_TTS_MODEL=eleven_turbo_v2_5
