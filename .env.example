# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — your keys never leave your machine.

# --- ElevenLabs (text-to-speech) ---
# Get an API key at https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Voice ID for the assistant's voice (from your ElevenLabs voice library)
ALFRED_VOICE_ID=your_elevenlabs_voice_id
# Voices for the other contacts. A contact without one still works, in text.
LUCIUS_VOICE_ID=
CATWOMAN_VOICE_ID=
NIGHTWING_VOICE_ID=
REDHOOD_VOICE_ID=
ROBIN_VOICE_ID=
BATGIRL_VOICE_ID=
BATWING_VOICE_ID=
ORPHAN_VOICE_ID=
# The console's own voice — the Batcomputer — for logging in and out and for
# placing and ending calls. Optional; without it those moments are silent.
BATCOMPUTER_VOICE_ID=

# --- Your identity (shown in the console, and used as a Whisper hint) ---
WAYNE_USER_NAME=YourName

# Which Ollama model Alfred answers with. Every other per-character setting —
# display name, role, voice, sampling parameters, worked examples — lives in
# wayne/contacts/profiles/alfred.json, not here.
ALFRED_OLLAMA_MODEL=alfred

# Where you are, as a place name. Optional: when set, he gets a live weather
# reading for it (Open-Meteo, no key needed) instead of imagining one, and
# local weather questions are answered from it without a web search.
# WAYNE_LOCATION=London
# What to call it in conversation — e.g. Gotham.
# WAYNE_LOCATION_NAME=Gotham

# Headlines he has glanced at: any RSS feed, titles only, refreshed half-hourly.
# WAYNE_NEWS_FEED=https://feeds.bbci.co.uk/news/rss.xml

# Today's and tomorrow's events from macOS Calendar (any account added there).
# The first read asks for Calendar permission.
# WAYNE_CALENDAR=1

# How the voice should say names it gets wrong, "Word:Spelling;Other:Spelling".
# Applied to speech only; the screen keeps the real spelling.
# WAYNE_PRONOUNCE=Siobhan:Shivawn

# --- Push-to-talk hotkey (pynput key name) ---
# Examples: Key.cmd_r, Key.shift_r, Key.ctrl_r
WAYNE_PTT_KEY=Key.cmd_r

# --- Speech to text ---
# Fallback hint words. The console also builds hints per request from who is on
# the line and what was just said, which is what stops Whisper inventing
# spellings for names — measured at 83% -> 100% word accuracy on hard audio.
WAYNE_WHISPER_HINTS=Alfred, YourName

# `small.en` is the default on measurement, not habit: ~0.2s on an M-series
# Mac, and a model four times the size was three times slower without being
# more accurate. Change it if your room or accent says otherwise.
WAYNE_WHISPER_MODEL=mlx-community/whisper-small.en-mlx

# --- Web console ---
WAYNE_WEB_HOST=127.0.0.1
WAYNE_WEB_PORT=8420

# Lock-screen passcode. This is stagecraft, not security — it is checked in the
# page, the server gates nothing on it, and it sits in plain text right here.
# Don't put anything behind it that actually needs protecting.
WAYNE_PASSCODE=zorro

# Contact the console connects to on load.
WAYNE_DEFAULT_CONTACT=alfred

# --- Memory encryption ---
# Encrypts conversation history and the vault at rest. Generate one with
# `python run.py --new-key`. Real encryption, unlike the lock screen above —
# but the key lives here beside the data, so it guards against casual reading,
# backups and sync clients, not against someone who already has this file.
# Lose the key and the memory is unreadable.
# WAYNE_MEMORY_KEY=

# --- Web search (optional) ---
# Without a key, search uses DuckDuckGo: no account needed, but scraped and
# rate-limited, so it can return nothing under repeated use. Brave is a real
# API with a free tier and cleaner results — https://brave.com/search/api/
# BRAVE_API_KEY=

# --- Latency ---
# How long Ollama keeps the model resident. The default 5m means a chat resumed
# after a coffee pays a full ~25s model load before the first word.
WAYNE_MODEL_KEEP_ALIVE=1h

# --- ElevenLabs model (optional) ---
WAYNE_TTS_MODEL=eleven_v4_turbo
