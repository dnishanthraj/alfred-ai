# System
.DS_Store

# Python
venv/
__pycache__/
*.pyc

# Secrets
.env
*.env
!.env.example

# Personal configuration (contains your real name/details — see .example templates).
# The glob catches backups too: Modelfile.bak holds the same personal content.
Modelfile
Modelfile.bak
Modelfile.*
!Modelfile.example

# Audio/video assets (large, machine-local)
*.wav
*.mp4

# Persistent state (machine-specific, contains conversation history/personal facts).
# One directory per contact: data/<contact>/history.json + vault.txt
data/
batcomputer_history.json
batcomputer_vault.txt
*.migrated

# Generated macOS app bundle — built by scripts/make_app.command, and rebuilt
# whenever the project moves, so it has no business being committed.
WayneTech Console.app/

# Test / tooling caches
.pytest_cache/
.ruff_cache/

# Personal working notes (rough, not curated for public consumption)
TODO.md

# Contact portraits added through the console. Whatever you drop on a bio card
# is yours — a photograph, or an actor's likeness with someone else's copyright
# on it — and neither belongs in a public repository. The shipped placeholder
# silhouette is committed; nothing else here is.
web/portraits/*
!web/portraits/_silhouette.svg
